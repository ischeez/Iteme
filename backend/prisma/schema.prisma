// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum TransactionType {
  APPROVED
  PENDING
  CANCELLED
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  OPEN
  CLOSED
  FULFILLED

}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductSize {
  S
  M
  L
  XL
  XXL
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  products    Product[]
  createdAt   DateTime  @default(now())  
}

model Product {
  id              Int       @id @default(autoincrement())
  name            String    
  description     String    @default("")
  brand           String    @default("Другое")
  size            ProductSize @default(M)
  sellerContact   String    @default("")
  quantity        Int       @default(0)
  price           Int
  imageUrl        String?
  sellerId        String?
  seller          User?     @relation("UserProducts", fields: [sellerId], references: [id])
  reviews         SellerReview[]
  interactions    BuyerSellerInteraction[]
  categoryId      Int
  category        Category  @relation(fields: [categoryId], references: [id]) 
  transactions    Transaction[]
  createdAt       DateTime  @default(now()) 

  @@index([sellerId])
}

model Transaction {
  id          Int                 @id @default(autoincrement())
  type        TransactionType
  amount      Int  
  comment     String? 
  productId   Int
  product     Product             @relation(fields: [productId], references: [id]) 
  createdAt   DateTime            @default(now())  
}

model User {
  id               String              @id @default(uuid())
  telegramId       BigInt              @unique
  username         String?                 
  firstName        String?
  lastName         String?
  avatarUrl        String?
  isAdmin          Boolean             @default(false)
  role             Role                @default(BUYER)
  isVerified       Boolean             @default(false)
  subscription     Subscription?
  products         Product[]           @relation("UserProducts")
  adminProfile     AdminProfileSettings?
  reviewsWritten   SellerReview[]      @relation("SellerReviewAuthor")
  reviewsReceived  SellerReview[]      @relation("SellerReviewSeller")
  interactions     BuyerSellerInteraction[] @relation("BuyerInteractions")
  interactionsAsSeller BuyerSellerInteraction[] @relation("SellerInteractions")
  orders           Order[]             @relation("BuyerOrders")
  productListings  ProductListing[]    @relation("SellerOrders")
  requests         BuyerRequest[]      @relation("UserRequests")
  offers           Offer[]             @relation("UserOffers")
  verificationRequests VerificationRequest[]
  createdAt        DateTime            @default(now())

}


model Subscription {
  id                 String               @id @default(uuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id])
  isActive           Boolean              @default(false)
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Order {
  id                 String                @id @default(uuid())
  buyerId            String                
  buyer              User                  @relation("BuyerOrders", fields: [buyerId], references: [id])
  listingId          String
  listing            ProductListing        @relation(fields: [listingId], references: [id])
  status             OrderStatus           @default(PENDING)
  priceAtBuy         Int   
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt         
}

model ProductListing {
  id                String                 @id @default(uuid())
  sellerId          String                  
  seller            User                   @relation("SellerOrders", fields: [sellerId], references: [id])
  title             String                 
  description       String
  price             Int
  imageUrls         String[]
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  orders            Order[]
}

model BuyerRequest {
  id                String                 @id @default(uuid())
  title             String
  description       String
  targetPrice       Int
  status            OfferStatus            @default(OPEN)
  buyerId           String
  buyer             User                   @relation("UserRequests", fields: [buyerId], references: [id])
  offers            Offer[]             
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Offer {
  id                String                  @id @default(uuid())
  price             Int
  comment           String?
  isAccepted        Boolean                 @default(false)
  requestId         String
  request           BuyerRequest            @relation(fields: [requestId], references: [id])
  sellerId          String              
  seller            User                    @relation("UserOffers", fields: [sellerId], references: [id])
  createdAt         DateTime                @default(now())
}

model VerificationRequest {
  id            String                    @id @default(uuid())
  userId        String
  user          User                      @relation(fields: [userId], references: [id])
  status        VerificationRequestStatus @default(PENDING)
  details       String
  evidenceImages String[]                 @default([])
  adminComment  String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
}

model SellerReview {
  id         String   @id @default(uuid())
  sellerId   String
  seller     User     @relation("SellerReviewSeller", fields: [sellerId], references: [id])
  buyerId    String
  buyer      User     @relation("SellerReviewAuthor", fields: [buyerId], references: [id])
  productId  Int?
  product    Product? @relation(fields: [productId], references: [id])
  rating     Int
  comment    String?
  sellerReply String?
  sellerReplyAt DateTime?
  createdAt  DateTime @default(now())

  @@index([sellerId])
  @@index([buyerId])
  @@index([productId])
  @@unique([sellerId, buyerId])
}

model BuyerSellerInteraction {
  id         String   @id @default(uuid())
  buyerId    String
  buyer      User     @relation("BuyerInteractions", fields: [buyerId], references: [id])
  sellerId   String
  seller     User     @relation("SellerInteractions", fields: [sellerId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@index([buyerId, sellerId])
  @@index([sellerId])
  @@index([productId])
  @@unique([buyerId, sellerId, productId])
}

model Guarantor {
  id          String   @id @default(uuid())
  nickname    String
  avatarUrl   String?
  description String?
  contact     String
  telegramUrl String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model HomepageSettings {
  id              String   @id
  bannerTitle     String?
  bannerSubtitle  String?
  bannerImageUrl  String?
  bannerLinkUrl   String?
  isBannerEnabled Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model AdminProfileSettings {
  id          String   @id @default(uuid())
  adminUserId String   @unique
  adminUser   User     @relation(fields: [adminUserId], references: [id])
  nickname    String?
  avatarUrl   String?
  bio         String?
  updatedAt   DateTime @updatedAt
}












